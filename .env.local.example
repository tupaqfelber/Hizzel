# Supabase — from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vision LLM for floor-plan extraction (server-side only, never exposed to the client)
ANTHROPIC_API_KEY=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Stripe (dormant until NEXT_PUBLIC_BILLING_ENABLED=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs (not Product IDs) from Stripe Dashboard > Products, test mode
STRIPE_PRICE_PASS_ID=
STRIPE_PRICE_ANNUAL_ID=
NEXT_PUBLIC_BILLING_ENABLED=false
