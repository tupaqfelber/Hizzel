# Stripe (scaffolded, dormant until NEXT_PUBLIC_BILLING_ENABLED=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_BILLING_ENABLED=false
